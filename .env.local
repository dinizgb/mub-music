# Public site URL for canonical links and Open Graph during SSR/prerender.
# Copy to `.env` / set in Vercel Project Settings → Environment Variables.
VITE_SITE_URL=https://your-domain.example

# GraphQL API root host (without protocol) used by the legacy site.
# Example: https://wp.mubmusic.com
VITE_API_ROOT_PATH=https://wp.mubmusic.com
